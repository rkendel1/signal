{
  "name": "signal",
  "private": true,
  "version": "0.3.0",
  "description": "Signal: connect sources, define what matters, and continuously surface explainable, evidence-backed findings. A FeltKit application.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "feltkit dev",
    "build": "feltkit build",
    "start": "feltkit start",
    "test": "feltkit test",
    "test:lib": "node --test tests/lib/*.test.ts",
    "inspect": "feltkit inspect",
    "typecheck": "tsc --noEmit",
    "build:extension": "node scripts/build-extension.ts",
    "test:e2e": "node --test tests/e2e/*.e2e.ts",
    "measure": "node scripts/measure.ts"
  },
  "dependencies": {
    "@feltdb/feltkit": "0.3.31",
    "cheerio": "1.2.0"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "6.4.5"
  }
}
