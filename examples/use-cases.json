{
  "schema": "signal.examples/v1",
  "note": "Each case: a criteria definition plus sample content that must and must not match. Exercised by test/examples.test.ts.",
  "cases": [
    {
      "name": "Product price drops below $100",
      "contentType": "text/html",
      "criteria": { "id": "price-drop", "name": "Price under $100", "severity": "warning",
        "extract": [{ "field": "price", "from": "text", "pattern": "\\$\\s*([0-9][0-9,]*\\.?[0-9]*)", "type": "number" }],
        "condition": { "field": "price", "op": "lt", "value": 100 } },
      "matches": "<p>Now only <b>$89.99</b></p>",
      "doesNotMatch": "<p>Now only <b>$129.99</b></p>"
    },
    {
      "name": "Remote AI product roles in job listings",
      "contentType": "text/html",
      "criteria": { "id": "jobs", "name": "Remote AI PM roles", "severity": "info",
        "condition": { "all": [
          { "text": { "matches": "\\b(AI|machine learning)\\b[^\\n]{0,40}\\bproduct\\b", "flags": "i" } },
          { "text": { "contains": "remote" } },
          { "not": { "text": { "matches": "\\b(on-?site only|no remote)\\b" } } } ] } },
      "matches": "<li>Senior AI Product Manager — Remote (US)</li>",
      "doesNotMatch": "<li>AI Product Manager — On-site only, Austin</li>"
    },
    {
      "name": "Government page: new regulation mentioning a topic (typo tolerant)",
      "contentType": "text/html",
      "criteria": { "id": "reg", "name": "Autonomous vehicle regulation", "severity": "critical",
        "condition": { "all": [ { "text": { "fuzzy": { "term": "autonomous vehicle", "maxDistance": 2 } } }, { "text": { "matches": "\\b(final rule|proposed rule|regulation)\\b" } } ] } },
      "matches": "<h2>Proposed rule: safety standards for autonomus vehicles</h2>",
      "doesNotMatch": "<h2>Proposed rule: bicycle lane standards</h2>"
    },
    {
      "name": "Competitor pricing change (needs a previous observation)",
      "contentType": "text/html",
      "criteria": { "id": "competitor", "name": "Competitor Pro plan price changed", "severity": "warning",
        "extract": [{ "field": "pro_price", "from": "text", "pattern": "Pro[^$]{0,40}\\$([0-9]+)", "type": "number" }],
        "condition": { "field": "pro_price", "op": "changed" } },
      "previous": "<div>Pro plan — $49/mo</div>",
      "matches": "<div>Pro plan — $59/mo</div>",
      "doesNotMatch": "<div>Pro plan — $49/mo</div>"
    },
    {
      "name": "API contract changed (structured JSON)",
      "contentType": "application/json",
      "criteria": { "id": "api", "name": "OpenAPI version or path count changed", "severity": "info",
        "extract": [{ "field": "version", "from": "json", "pointer": "/info/version", "type": "string" }],
        "condition": { "any": [ { "field": "version", "op": "changed" }, { "content": "changed" } ] } },
      "previous": "{\"info\":{\"version\":\"1.0.0\"},\"paths\":{\"/a\":{}}}",
      "matches": "{\"info\":{\"version\":\"1.1.0\"},\"paths\":{\"/a\":{}}}",
      "doesNotMatch": "{\"info\":{\"version\":\"1.0.0\"},\"paths\":{\"/a\":{}}}"
    },
    {
      "name": "Monitored element removed",
      "contentType": "text/html",
      "criteria": { "id": "removed", "name": "Free tier disappeared", "severity": "critical",
        "extract": [{ "field": "free_tier", "from": "text", "pattern": "(Free tier)", "type": "string" }],
        "condition": { "field": "free_tier", "op": "absent" } },
      "matches": "<ul><li>Pro</li><li>Enterprise</li></ul>",
      "doesNotMatch": "<ul><li>Free tier</li><li>Pro</li></ul>"
    },
    {
      "name": "Embedded Ghostpost reference detected",
      "contentType": "text/plain",
      "criteria": { "id": "gp-ref", "name": "Ghostpost reference to our campaign", "severity": "info",
        "condition": { "signal": { "codec": "ghostpost-unicode/v1", "kind": "reference", "payloadContains": "campaign-" } } },
      "matches": { "encodeReference": ["Check this out", "ghostpost", "campaign-2026"] },
      "doesNotMatch": "Check this out"
    }
  ]
}
