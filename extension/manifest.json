{
	"manifest_version": 3,
	"name": "Signal",
	"version": "0.1.0",
	"description": "Capture the page you are viewing into your Signal instance, discover candidates for your intent, and see alerts for the page.",
	"minimum_chrome_version": "116",
	"background": { "service_worker": "background.js", "type": "module" },
	"action": { "default_title": "Open Signal" },
	"side_panel": { "default_path": "panel.html" },
	"permissions": ["sidePanel", "storage", "activeTab", "scripting", "tabs"],
	"optional_host_permissions": ["http://*/*", "https://*/*"],
	"web_accessible_resources": [
		{ "resources": ["codec/ghostpost_unicode_codec.js", "codec/ghostpost_unicode_codec_bg.wasm"], "matches": ["http://*/*", "https://*/*"] }
	],
	"content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" }
}
