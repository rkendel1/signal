{
	"manifest_version": 3,
	"name": "Signal",
	"version": "0.3.0",
	"description": "Capture the page you are viewing into a Signal browser-capture source and see which of your findings it affects.",
	"minimum_chrome_version": "116",
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"action": {
		"default_title": "Open Signal",
		"default_icon": {
			"16": "icons/icon16.png",
			"48": "icons/icon48.png"
		}
	},
	"side_panel": {
		"default_path": "panel.html"
	},
	"permissions": [
		"sidePanel",
		"storage",
		"activeTab",
		"scripting",
		"tabs"
	],
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"optional_host_permissions": [
		"http://*/*",
		"https://*/*"
	],
	"content_security_policy": {
		"extension_pages": "script-src 'self'; object-src 'self'"
	}
}
